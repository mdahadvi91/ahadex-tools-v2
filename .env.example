# Copy to .env for local development. Never commit .env.
# WARNING: every VITE_ variable is bundled into public JavaScript.
# Never put secrets, tokens or private keys in any VITE_ variable.

# Canonical site URL: https, no trailing slash.
# Used for canonical links, sitemap and Open Graph.
# The production build fails if this is empty or invalid.
VITE_SITE_URL=https://ahadex.online

# Google Analytics 4 measurement ID. Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# AdSense publisher ID (ca-pub-...). Leave empty to disable ads.
# Set only after the AdSense account is approved.
VITE_ADSENSE_PUBLISHER_ID=
