# Primary site URL (https, no trailing slash)
VITE_SITE_URL=https://ahadex.online

# Optional Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Optional Google AdSense publisher ID (format: ca-pub-0000000000000000)
VITE_ADSENSE_PUBLISHER_ID=

# Microsoft Clarity project ID (default: zkc26mkuvb; set to "off" to disable)
VITE_CLARITY_PROJECT_ID=zkc26mkuvb

# Optional Bing Webmaster & Yandex Webmaster HTML verification tokens
VITE_BING_SITE_VERIFICATION=
VITE_YANDEX_SITE_VERIFICATION=