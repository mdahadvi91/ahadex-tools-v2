import fs from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';

import { assertValidEnvironment, getEnvironment } from '../../src/config/environment';
import { discoverToolManifests } from '../utils/tool-discovery';

interface SsrModule {
  render?: (url: string) => string;
}

interface RenderRoute {
  path: string;
  title: string;
  description: string;
}

function escapeHtml(value: string): string {
  return value.replace(/[&<>"']/g, (character) => {
    const entities: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    };

    return entities[character] ?? character;
  });
}

function writeFile(filePath: string, content: string): void {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, content, 'utf8');
}

async function main(): Promise<void> {
  assertValidEnvironment();

  const env = getEnvironment();

  const rootDir = process.cwd();
  const distDir = path.resolve(rootDir, 'dist');
  const templatePath = path.join(distDir, 'index.html');
  const ssrBundlePath = path.resolve(
    rootDir,
    '.build/server/entry-server.js',
  );

  if (!fs.existsSync(templatePath)) {
    throw new Error(
      `Missing built HTML template: ${templatePath}. Run build:client first.`,
    );
  }

  if (!fs.existsSync(ssrBundlePath)) {
    throw new Error(
      `Missing SSR bundle: ${ssrBundlePath}. Run build:ssr first.`,
    );
  }

  const template = fs.readFileSync(templatePath, 'utf8');

  if (!template.includes('<div id="root"></div>')) {
    throw new Error(
      'HTML template is missing the expected empty root element.',
    );
  }

  const ssrModule = (await import(
    pathToFileURL(ssrBundlePath).href
  )) as SsrModule;

  if (typeof ssrModule.render !== 'function') {
    throw new Error(
      'SSR bundle must export a callable named "render" function.',
    );
  }

  const render = ssrModule.render;
  const tools = await discoverToolManifests();

  const routes: RenderRoute[] = [
    {
      path: '/',
      title: 'AHADEX Tools - Fast, Private Browser Utilities',
      description:
        '100% browser-based image and PDF tools. Your files stay on your device.',
    },
    ...tools.map((tool) => ({
      path: tool.path,
      title: tool.title,
      description: tool.description,
    })),
  ];

  for (const route of routes) {
    const appHtml = render(route.path);

    if (typeof appHtml !== 'string') {
      throw new Error(`SSR returned invalid HTML for route: ${route.path}`);
    }

    const outputDirectory =
      route.path === '/'
        ? distDir
        : path.resolve(distDir, route.path.slice(1));

    const relativeOutput = path.relative(distDir, outputDirectory);

    if (
      relativeOutput.startsWith('..') ||
      path.isAbsolute(relativeOutput)
    ) {
      throw new Error(`Unsafe prerender output path: ${route.path}`);
    }

    let html = template.replace(
      '<div id="root"></div>',
      `<div id="root">${appHtml}</div>`,
    );

    html = html.replace(
      /<title>.*?<\/title>/s,
      `<title>${escapeHtml(route.title)}</title>`,
    );

    writeFile(
      path.join(outputDirectory, 'index.html'),
      html,
    );
  }

  const llmsLines = [
    '# AHADEX Tools',
    '',
    '> Privacy-first, 100% browser-based utilities. Files are processed locally in the browser without uploading to external servers.',
    '',
    `- Site: ${env.siteUrl}`,
    '',
    '## Available Tools',
    ...tools.map(
      (tool) =>
        `- [${tool.title}](${env.siteUrl}${tool.path}): ${tool.description}`,
    ),
    '',
  ];

  const llmsContent = llmsLines.join('\n');

  writeFile(
    path.resolve(rootDir, 'public/llms.txt'),
    llmsContent,
  );

  writeFile(
    path.join(distDir, 'llms.txt'),
    llmsContent,
  );

  console.log(
    `Prerendered ${routes.length} routes and generated llms.txt.`,
  );
}

main().catch((error: unknown) => {
  console.error(
    'Prerender failed:',
    error instanceof Error ? error.message : error,
  );

  process.exitCode = 1;
});
