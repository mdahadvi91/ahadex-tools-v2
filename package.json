{
  "name": "ahadex-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AHADEX Tools: privacy-first browser-based file utilities on https://ahadex.online",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:vite": "vite build",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/app/entry-server.tsx --outDir .build/server",
    "prerender": "tsx scripts/prerender/generate-prerender.ts",
    "discover:tools": "tsx scripts/discovery/discover-tools.ts",
    "validate:routes": "tsx scripts/validation/validate-routes.ts",
    "build:ssg": "npm run generate:assets && npm run generate:sitemap && npm run build:client && npm run build:ssr && npm run prerender && tsx scripts/validation/validate-routes.ts --verify-dist && tsx scripts/sitemap/validate-sitemap.ts --verify-dist && tsx scripts/images/validate-assets.ts --verify-dist",
    "generate:sitemap": "tsx scripts/sitemap/generate-sitemap.ts",
    "validate:sitemap": "tsx scripts/sitemap/validate-sitemap.ts",
    "validate:robots": "tsx scripts/sitemap/validate-robots.ts",
    "generate:assets": "tsx scripts/images/generate-assets.ts",
    "validate:assets": "tsx scripts/images/validate-assets.ts",
    "sitemap:generate": "tsx scripts/tasks/sitemap.ts --generate",
    "deployment:generate": "tsx scripts/tasks/deployment.ts --generate",
    "indexnow:submit": "tsx scripts/tasks/indexnow.ts",
    "check:deployment": "tsx scripts/tasks/deployment.ts",
    "validate:pre": "tsx scripts/production/prebuild-validation.ts",
    "validate:post": "tsx scripts/production/final-validation.ts",
    "validate:all": "tsx scripts/orchestrators/validate.ts --phase=all",
    "build": "tsx scripts/production/build-orchestrator.ts",
    "check:seo": "tsx scripts/seo/validate-metadata.ts",
    "check:canonical": "tsx scripts/seo/validate-canonical.ts",
    "check:schema": "tsx scripts/seo/validate-schema.ts",
    "check:content": "tsx scripts/content/validate-content.ts",
    "check:crawlers": "tsx scripts/crawlers/simulate-crawlers.ts",
    "check:a11y": "tsx scripts/validation/validate-accessibility.ts",
    "check:security": "tsx scripts/validation/validate-security.ts",
    "audit:accessibility": "tsx scripts/tasks/accessibility.ts",
    "audit:performance": "tsx scripts/tasks/performance.ts",
    "audit:all": "npm run type-check && npm run lint && npm run build && npm run test",
    "ci": "npm run type-check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
