{
  "name": "ahadex-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AHADEX Tools: privacy-first browser-based file tools",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:quality": "tsx scripts/orchestrators/quality.orchestrator.ts",
    "check:seo": "tsx scripts/orchestrators/seo.orchestrator.ts",
    "check:content": "tsx scripts/orchestrators/content.orchestrator.ts",
    "check:geo": "tsx scripts/orchestrators/geo.orchestrator.ts",
    "check:schema": "tsx scripts/orchestrators/schema.orchestrator.ts",
    "check:assets": "tsx scripts/orchestrators/assets.orchestrator.ts",
    "check:indexing": "tsx scripts/orchestrators/indexing.orchestrator.ts",
    "check:growth": "tsx scripts/orchestrators/growth.orchestrator.ts",
    "check:architecture": "tsx scripts/orchestrators/architecture.orchestrator.ts",
    "check:security": "tsx scripts/orchestrators/security.orchestrator.ts",
    "check:privacy": "tsx scripts/orchestrators/privacy.orchestrator.ts",
    "check:accessibility": "tsx scripts/orchestrators/accessibility.orchestrator.ts",
    "check:performance": "tsx scripts/orchestrators/performance.orchestrator.ts",
    "check:analytics": "tsx scripts/orchestrators/analytics.orchestrator.ts",
    "check:i18n": "tsx scripts/orchestrators/i18n.orchestrator.ts",
    "check:adsense": "tsx scripts/orchestrators/adsense.orchestrator.ts",
    "check:production": "tsx scripts/orchestrators/production.orchestrator.ts",
    "check:all": "tsx scripts/orchestrators/all.orchestrator.ts",
    "generate:sitemap": "tsx scripts/tasks/indexing/generate-sitemap.ts",
    "prebuild": "tsx scripts/tasks/indexing/generate-sitemap.ts",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
