{
  "name": "ahadex-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AHADEX Tools: privacy-first browser-based file tools",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/app/entry-server.tsx --outDir .build/server",
    "prerender": "tsx scripts/build/prerender.ts",
    "sitemap:generate": "tsx scripts/tasks/sitemap.ts --generate",
    "deployment:generate": "tsx scripts/tasks/deployment.ts --generate",
    "validate:pre": "tsx scripts/orchestrators/validate.ts --phase=pre",
    "validate:post": "tsx scripts/orchestrators/validate.ts --phase=post",
    "validate:all": "tsx scripts/orchestrators/validate.ts --phase=all",
    "build": "tsx scripts/orchestrators/build.ts",
    "audit:accessibility": "tsx scripts/tasks/accessibility.ts",
    "audit:performance": "tsx scripts/tasks/performance.ts",
    "ci": "npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
